
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Shared Role-Based Access:
     * This application uses fixed profile identifiers ('manager', 'staff') 
     * to allow shared data access across different devices.
     * Any authenticated user (including anonymous) can access these shared buckets.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    match /profiles/{profileId} {
      allow read, write: if isSignedIn() && (profileId == 'manager' || profileId == 'staff');

      match /sellers/{sellerId} {
        allow read, write: if isSignedIn();
      }

      match /sales/{saleId} {
        allow read, write: if isSignedIn();
      }
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
