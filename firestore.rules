
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidProfile(profileId) {
      return profileId == 'manager' || profileId == 'staff' || profileId == 'trade' || profileId == 'raffle';
    }

    match /profiles/{profileId} {
      allow read, write: if isSignedIn() && isValidProfile(profileId);
    }

    match /profiles/{profileId}/sellers/{sellerId} {
      allow read, write: if isSignedIn() && isValidProfile(profileId);
    }

    match /profiles/{profileId}/sellers/{sellerId}/inventory/{itemId} {
      allow read, write: if isSignedIn() && isValidProfile(profileId);
    }

    match /profiles/{profileId}/sales/{saleId} {
      allow read, write: if isSignedIn() && isValidProfile(profileId);
    }

    match /shop-finance-totals/{date} {
      allow read, write: if isSignedIn();
    }

    match /shop-finance-expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /trade-ins/{tradeId} {
      allow read, write: if isSignedIn();
    }

    match /raffle-entries/{entryId} {
      allow read, write: if isSignedIn();
    }

    match /wanted-stock/{id} {
      allow read, write: if isSignedIn();
    }

    match /stock-matches/{id} {
      allow read, write: if isSignedIn();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
