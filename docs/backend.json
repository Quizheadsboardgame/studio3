
{
  "entities": {
    "Seller": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Seller",
      "type": "object",
      "description": "Represents an individual seller of collectible cards.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Seller entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the seller."
        },
        "defaultCommission": {
          "type": "number",
          "description": "The default commission percentage (%) the manager earns per sale from this seller."
        },
        "password": {
          "type": "string",
          "description": "A secure access key for the seller to view their personal performance."
        },
        "archived": {
          "type": "boolean",
          "description": "Whether the seller is currently archived (inactive) but still in the database."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Sale": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Sale",
      "type": "object",
      "description": "Records an individual transaction for a collectible card.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Sale entity."
        },
        "cardName": {
          "type": "string",
          "description": "The name of the collectible card sold."
        },
        "price": {
          "type": "number",
          "description": "The sale price of the card, in the local currency (e.g., GBP)."
        },
        "commission": {
          "type": "number",
          "description": "The commission amount (calculated from percentage) designated for the manager from this sale."
        },
        "saleDate": {
          "type": "string",
          "description": "The date when the sale was recorded, in YYYY-MM-DD format.",
          "format": "date"
        },
        "sellerId": {
          "type": "string",
          "description": "Reference to the Seller who made this sale."
        },
        "payoutStatus": {
          "type": "string",
          "description": "Current status of the payout for this sale.",
          "enum": ["pending", "paid"]
        },
        "paymentMethod": {
          "type": "string",
          "description": "The method used to pay the seller.",
          "enum": ["cash", "transfer"]
        },
        "paidAt": {
          "type": "string",
          "description": "The timestamp when the payout was settled.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "cardName",
        "price",
        "saleDate",
        "sellerId"
      ]
    },
    "ShopTotal": {
      "title": "Shop Total",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "cashIntake": { "type": "number" },
        "cardIntake": { "type": "number" },
        "totalIntake": { "type": "number" }
      },
      "required": ["date", "cashIntake", "cardIntake", "totalIntake"]
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["date", "description", "amount"]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/profiles/{profileId}/sellers/{sellerId}",
        "definition": {
          "entityName": "Seller",
          "schema": {
            "$ref": "#/backend/entities/Seller"
          },
          "description": "Shared seller profiles."
        }
      },
      {
        "path": "/profiles/{profileId}/sales/{saleId}",
        "definition": {
          "entityName": "Sale",
          "schema": {
            "$ref": "#/backend/entities/Sale"
          },
          "description": "Shared sales transactions."
        }
      },
      {
        "path": "/shop-finance-totals/{date}",
        "definition": {
          "entityName": "ShopTotal",
          "description": "Daily total shop intake records."
        }
      },
      {
        "path": "/shop-finance-expenses/{expenseId}",
        "definition": {
          "entityName": "Expense",
          "description": "Daily shop expenses."
        }
      }
    ]
  }
}
