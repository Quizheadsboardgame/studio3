
{
  "entities": {
    "Seller": {
      "title": "Seller",
      "type": "object",
      "description": "Represents an individual seller of collectible cards.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "defaultCommission": { "type": "number" },
        "password": { "type": "string" },
        "archived": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Sale": {
      "title": "Sale",
      "type": "object",
      "description": "Records an individual transaction for a collectible card.",
      "properties": {
        "id": { "type": "string" },
        "cardName": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "commission": { "type": "number" },
        "saleDate": { "type": "string", "format": "date" },
        "sellerId": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["cash", "transfer"] },
        "paidAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "cardName", "price", "saleDate", "sellerId"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" }
      },
      "required": ["name", "price"]
    },
    "ShopTotal": {
      "title": "Shop Total",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "cashIntake": { "type": "number" },
        "cardIntake": { "type": "number" },
        "totalIntake": { "type": "number" }
      },
      "required": ["date", "cashIntake", "cardIntake", "totalIntake"]
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["date", "description", "amount"]
    },
    "TradeIn": {
      "title": "Trade-in Evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "number" }
            }
          }
        },
        "marketTotal": { "type": "number" },
        "offerAmount": { "type": "number" },
        "offerType": { "type": "string", "enum": ["trade", "cash"] },
        "customerName": { "type": "string" }
      },
      "required": ["date", "marketTotal", "offerAmount", "offerType"]
    },
    "RaffleEntry": {
      "title": "Raffle Entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tickets": { "type": "number" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["name", "tickets", "date"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/profiles/{profileId}/sellers/{sellerId}": {
      "schema": { "$ref": "#/backend/entities/Seller" },
      "description": "Seller profiles."
    },
    "/profiles/{profileId}/sellers/{sellerId}/inventory/{itemId}": {
      "schema": { "$ref": "#/backend/entities/InventoryItem" },
      "description": "Preloaded inventory for quick adding by staff."
    },
    "/profiles/{profileId}/sales/{saleId}": {
      "schema": { "$ref": "#/backend/entities/Sale" },
      "description": "Sales transactions."
    },
    "/shop-finance-totals/{date}": {
      "schema": { "$ref": "#/backend/entities/ShopTotal" },
      "description": "Daily total shop intake records."
    },
    "/shop-finance-expenses/{expenseId}": {
      "schema": { "$ref": "#/backend/entities/Expense" },
      "description": "Daily shop expenses."
    },
    "/trade-ins/{tradeId}": {
      "schema": { "$ref": "#/backend/entities/TradeIn" },
      "description": "Trade-in and buyback records."
    },
    "/raffle-entries/{entryId}": {
      "schema": { "$ref": "#/backend/entities/RaffleEntry" },
      "description": "Individual raffle ticket entries."
    }
  }
}
